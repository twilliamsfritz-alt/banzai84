# ── App ──────────────────────────────────────────────────────────────────────
BANZAI_SECRET_KEY=change-me-in-production
FLASK_ENV=production
APP_URL=http://127.0.0.1:5000

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── WhatsApp Business Platform ───────────────────────────────────────────────
# Meta Business Suite → WhatsApp → API Setup
# Set DEFAULT_WHATSAPP_WORKSPACE_SLUG to route inbound messages to the right workspace
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
DEFAULT_WHATSAPP_WORKSPACE_SLUG=patagonia-trading

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
# Webhook secret at: https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── MercadoPago ──────────────────────────────────────────────────────────────
# Get your token at: https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=
